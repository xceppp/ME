# PEACE MODE environment
# Copy to .env.local and fill in real values. Never commit secrets.

# local (default) uses the built-in SQLite database in /data.
# supabase uses Supabase Auth, Postgres, and Row Level Security.
DATA_MODE=local

# Required for signed session cookies in local mode.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=

# Public site URL used in verification and password-reset links.
APP_URL=http://localhost:3000

# Optional SMTP. When unset, local mode does not require email verification.
# Password reset and verification links are shown in development server logs.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Supabase (required only when DATA_MODE=supabase)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only. Never prefix this with NEXT_PUBLIC.
SUPABASE_SERVICE_ROLE_KEY=
